# Ignore build artifacts and large directories
out/
cmake-build-*/
build/
build-win/
# NOTE: artifacts/ must NOT be ignored — docker-publish.yml extracts the CI
# build artifacts there and Dockerfile.prebuilt COPYs ./artifacts/* from the
# build context. Ignoring it (as cae5960 briefly did) breaks every prebuilt
# image build with "COPY /artifacts/OdbDesignServer: not found".
output/
siteout/
compile_commands.json
log.txt
designs/
new_designs/
compose-designs/

# Ignore IDE / agent-state directories (large or irrelevant to the build)
.vs/
.idea/
.vscode/
.cursor/
.gemini/
.qwen/
.zed/
.kilo/
.zcode/
.mimosa/
.delta/
.cache/

# Ignore Git-related files
.git/
.gitignore
.gitattributes

# Ignore GitHub-related files
.github/

# Ignore Docker-related files (the builder gets the Dockerfile itself)
docker-compose.yml
compose.yml
compose.local.yml
*.code-workspace

# Ignore vcpkg artifacts
vcpkg_installed/

# Ignore SSL certificates
ssl/

# Ignore testing artifacts
Testing/
testlog.txt
testlog.txt.tmp*
testlog.xml
TEST_DATA
TEST_DATA.zip
OdbDesignServer/designs/
OdbDesignServer/yaak

# Ignore generated docs
docs/api/

# Ignore other Docker files
Dockerfile*

# Local environment / credential files (may contain secrets) — never send to the builder
.env
.env.local
.env.*.local
local.nuget.config
nuget.generated.config
gpg_keys/
deploy/kubeconfig
