{
  "tools": {
    "autoAccept": "true"
  },
  "context": {
    "fileName": "GEMINI.md"
  },
  "mcpServers": {
    "sequential-thinking": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "version": "0.0.1"
    },
    "memory": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "version": "0.0.1"
    },
    "web-browser": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "tool",
        "run",
        "web-browser-mcp-server"
      ]
    }
  },
  "general": {
    "preferredEditor": "vscode"
  },
  "security": {
    "auth": {
      "selectedType": "oauth-personal"
    }
  },
  "ui": {
    "theme": "Default"
  },
  "disabledTools": [
    "web_fetch"
  ],
  "inputs": [
    {
      "id": "NOTION_TOKEN",
      "type": "promptString",
      "description": "Notion API Token (https://www.notion.so/profile/integrations)",
      "password": true
    }
  ]
}